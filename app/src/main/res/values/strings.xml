    <!-- Features and Feedback -->
    <string name="settings_features">Features</string>
    <string name="settings_feedback">Feedback</string>
    <string name="feedback_intro">Found a problem or have an idea? It opens a ready-made issue on GitHub in your browser, and you can edit everything before sending it.</string>
    <string name="feedback_bug">Report a bug</string>
    <string name="feedback_suggestion">Send a suggestion</string>
    <string name="feedback_data_title">What is included</string>
    <string name="feedback_includes">Only the app version, Android version, phone model and app language. Nothing else.</string>
    <string name="feedback_copy">Copy diagnostic info</string>
    <string name="feedback_copied">Copied.</string>
    <string name="feedback_account">You need a GitHub account to send it. Without one, copy the diagnostic info and send it however you like.</string>

    <!-- Features -->
    <string name="feature_share_title">Share and done</string>
    <string name="feature_share_body">Tap Share on a video and pick QuietDLP to download with your default. Pick \"QuietDLP options\" to choose first.</string>
    <string name="feature_quality_title">Quality and formats</string>
    <string name="feature_quality_body">Best, 1080p, 720p or audio only (M4A, MP3, Opus, FLAC and more). Choose a default or ask each time.</string>
    <string name="feature_sites_title">Rules per site</string>
    <string name="feature_sites_body">Always download the same thing from a website, for example audio from a music site.</string>
    <string name="feature_photos_title">Photos and galleries</string>
    <string name="feature_photos_body">When a link has no video, it downloads its photos. Choose how many, or all.</string>
    <string name="feature_profile_title">Profile photos</string>
    <string name="feature_profile_body">Paste a profile link from a social network to save its profile photo, and its banner in Advanced.</string>
    <string name="feature_groups_title">Playlists and several links</string>
    <string name="feature_groups_body">They become one group. Up to 5 downloads run at once, with a Wi-Fi only option.</string>
    <string name="feature_subtitles_title">Subtitles</string>
    <string name="feature_subtitles_body">Pick the language and save them inside the video (MP4 or MKV) or as a .srt file.</string>
    <string name="feature_trim_title">Trim</string>
    <string name="feature_trim_body">Download only a part of a video or song, with frames to see where you cut.</string>
    <string name="feature_music_title">Music names and tags</string>
    <string name="feature_music_body">Songs are named \"Artist - Title\" and tagged with title, artist, album and a cover image.</string>
    <string name="feature_cover_title">Cover image</string>
    <string name="feature_cover_body">Put the thumbnail inside the file as its cover. On by default for music, off for videos.</string>
    <string name="feature_convert_title">Convert</string>
    <string name="feature_convert_body">Turn a downloaded file into another format, with or without re-encoding.</string>
    <string name="feature_makevideo_title">Make video</string>
    <string name="feature_makevideo_body">Join the photos and the song of a post into one video.</string>
    <string name="feature_follow_title">Following</string>
    <string name="feature_follow_body">Follow a channel, playlist or gallery. It checks on its own and downloads only what is new.</string>
    <string name="feature_keys_title">Site keys</string>
    <string name="feature_keys_body">Some photo sites ask for your own key. It stays on your phone and is not in backups.</string>
    <string name="feature_advanced_title">Advanced mode</string>
    <string name="feature_advanced_body">Exact resolutions, SponsorBlock, chapters and file name templates.</string>
    <string name="feature_sessions_title">Sessions</string>
    <string name="feature_sessions_body">Sign in to a website, or import a cookies.txt, to download content that requires an account.</string>
    <string name="feature_history_title">History</string>
    <string name="feature_history_body">Share, delete, a warning for repeated links and automatic retry when the connection drops.</string>
    <string name="feature_backup_title">Backup</string>
    <string name="feature_backup_body">Save your settings, history and followed pages to a file, and restore them later.</string>
    <string name="feature_updates_title">Updates</string>
    <string name="feature_updates_body">yt-dlp, gallery-dl and the app itself can update by themselves. You can turn it off.</string>
    <string name="feature_appearance_title">Appearance</string>
    <string name="feature_appearance_body">Simple or Advanced mode, and color palettes: dark, colorful, light, wallpaper colors or your own.</string>
    <string name="feature_official_title">Official source</string>
    <string name="feature_official_body">Check that your copy is the real one by comparing its signature with the one on GitHub.</string>

