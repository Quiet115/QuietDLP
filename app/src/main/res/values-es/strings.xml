    <!-- Funciones y Comentarios -->
    <string name="settings_features">Funciones</string>
    <string name="settings_feedback">Comentarios</string>
    <string name="feedback_intro">¿Encontraste un problema o tienes una idea? Se abre en tu navegador un issue de GitHub ya preparado, y puedes editarlo todo antes de enviarlo.</string>
    <string name="feedback_bug">Reportar un error</string>
    <string name="feedback_suggestion">Enviar una sugerencia</string>
    <string name="feedback_data_title">Qué se incluye</string>
    <string name="feedback_includes">Solo la versión de la app, la versión de Android, el modelo del teléfono y el idioma de la app. Nada más.</string>
    <string name="feedback_copy">Copiar información de diagnóstico</string>
    <string name="feedback_copied">Copiado.</string>
    <string name="feedback_account">Necesitas una cuenta de GitHub para enviarlo. Sin ella, copia la información de diagnóstico y envíala como prefieras.</string>

    <!-- Features -->
    <string name="feature_share_title">Compartir y listo</string>
    <string name="feature_share_body">Toca Compartir en un vídeo y elige QuietDLP para descargar con tu opción por defecto. Con \"QuietDLP opciones\" eliges antes.</string>
    <string name="feature_quality_title">Calidad y formatos</string>
    <string name="feature_quality_body">La mejor, 1080p, 720p o solo audio (M4A, MP3, Opus, FLAC y más). Elige una por defecto o pregunta cada vez.</string>
    <string name="feature_sites_title">Reglas por sitio</string>
    <string name="feature_sites_body">Descarga siempre lo mismo de una web, por ejemplo audio de una web de música.</string>
    <string name="feature_photos_title">Fotos y galerías</string>
    <string name="feature_photos_body">Si un enlace no tiene vídeo, descarga sus fotos. Eliges cuántas, o todas.</string>
    <string name="feature_profile_title">Fotos de perfil</string>
    <string name="feature_profile_body">Pega el enlace de un perfil de una red social para guardar su foto de perfil, y el banner en Avanzado.</string>
    <string name="feature_groups_title">Listas y varios enlaces</string>
    <string name="feature_groups_body">Se agrupan en una sola tarjeta. Hasta 5 descargas a la vez, con opción de solo Wi-Fi.</string>
    <string name="feature_subtitles_title">Subtítulos</string>
    <string name="feature_subtitles_body">Elige el idioma y guárdalos dentro del vídeo (MP4 o MKV) o como archivo .srt.</string>
    <string name="feature_trim_title">Recortar</string>
    <string name="feature_trim_body">Descarga solo una parte de un vídeo o canción, con fotogramas para ver dónde cortas.</string>
    <string name="feature_music_title">Nombre y etiquetas de música</string>
    <string name="feature_music_body">Las canciones se llaman \"Artista - Título\" y llevan título, artista, álbum y portada.</string>
    <string name="feature_cover_title">Portada</string>
    <string name="feature_cover_body">Mete la miniatura dentro del archivo como portada. Activada en música y desactivada en vídeos.</string>
    <string name="feature_convert_title">Convertir</string>
    <string name="feature_convert_body">Convierte un archivo descargado a otro formato, con o sin recodificar.</string>
    <string name="feature_makevideo_title">Crear vídeo</string>
    <string name="feature_makevideo_body">Une las fotos y la canción de una publicación en un solo vídeo.</string>
    <string name="feature_follow_title">Seguidos</string>
    <string name="feature_follow_body">Sigue un canal, lista o galería. Revisa solo y descarga únicamente lo nuevo.</string>
    <string name="feature_keys_title">Claves de sitios</string>
    <string name="feature_keys_body">Algunas webs de fotos piden tu propia clave. Se queda en tu móvil y no entra en las copias.</string>
    <string name="feature_advanced_title">Modo avanzado</string>
    <string name="feature_advanced_body">Resoluciones exactas, SponsorBlock, capítulos y plantillas de nombre de archivo.</string>
    <string name="feature_sessions_title">Sesiones</string>
    <string name="feature_sessions_body">Inicia sesión en una web, o importa un cookies.txt, para descargar contenido que pide cuenta.</string>
    <string name="feature_history_title">Historial</string>
    <string name="feature_history_body">Compartir, borrar, aviso de enlaces repetidos y reintento automático si se corta la conexión.</string>
    <string name="feature_backup_title">Copia de seguridad</string>
    <string name="feature_backup_body">Guarda tus ajustes, historial y páginas seguidas en un archivo y restáuralos después.</string>
    <string name="feature_updates_title">Actualizaciones</string>
    <string name="feature_updates_body">yt-dlp, gallery-dl y la propia app pueden actualizarse solos. Puedes desactivarlo.</string>
    <string name="feature_appearance_title">Apariencia</string>
    <string name="feature_appearance_body">Modo Simple o Avanzado y paletas de color: oscura, colorida, clara, colores del fondo o la tuya.</string>
    <string name="feature_official_title">Fuente oficial</string>
    <string name="feature_official_body">Comprueba que tu copia es la oficial comparando su firma con la de GitHub.</string>

